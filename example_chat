<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>워크가이드 - 직업훈련 대응 챗봇</title>

  <style>
    :root {
      --bg: #f5f7fb;
      --panel: #ffffff;
      --ink: #1f2937;
      --muted: #6b7280;
      --line: #e5e7eb;
      --primary: #3559e0;
      --soft: #eef2ff;
      --success: #14855f;
      --danger: #b8322a;
      --shadow: 0 12px 36px rgba(20, 31, 61, 0.1);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family:
        Pretendard,
        "Noto Sans KR",
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: linear-gradient(
        135deg,
        #f8faff,
        #f3f6fb 58%,
        #edf2ff
      );
    }

    button,
    textarea {
      font: inherit;
    }

    .app {
      width: min(1180px, 100%);
      min-height: 100vh;
      margin: auto;
      padding: 22px;
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 18px;
    }

    .panel {
      background: rgba(255, 255, 255, 0.94);
      border: 1px solid var(--line);
      border-radius: 22px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      min-height: 720px;
    }

    .brand {
      padding: 24px 22px 18px;
      border-bottom: 1px solid var(--line);
    }

    .brand-row {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .logo {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: #ffffff;
      font-weight: 800;
      font-size: 22px;
      background: linear-gradient(135deg, #3559e0, #7182ef);
    }

    h1 {
      font-size: 20px;
      margin: 0;
    }

    .brand p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .side {
      padding: 18px;
    }

    .label {
      font-size: 12px;
      color: #8b93a7;
      font-weight: 800;
      letter-spacing: 0.08em;
      margin-bottom: 10px;
    }

    .scenario {
      width: 100%;
      border: 1px solid var(--line);
      background: #ffffff;
      border-radius: 14px;
      padding: 13px 14px;
      margin-bottom: 9px;
      text-align: left;
      cursor: pointer;
      display: flex;
      gap: 10px;
      transition: 0.18s;
    }

    .scenario:hover,
    .scenario.active {
      border-color: var(--primary);
      background: var(--soft);
      transform: translateY(-1px);
    }

    .scenario .emoji {
      font-size: 20px;
    }

    .scenario b {
      display: block;
      font-size: 14px;
      margin-bottom: 3px;
    }

    .scenario small {
      display: block;
      color: var(--muted);
      line-height: 1.4;
    }

    .note {
      margin: auto 18px 18px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #f7f8fb;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.55;
    }

    .chat {
      min-height: 720px;
      display: grid;
      grid-template-rows: auto 1fr auto;
    }

    .header {
      padding: 20px 22px;
      border-bottom: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .assistant {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #e9edff;
      font-size: 22px;
    }

    .assistant h2 {
      margin: 0;
      font-size: 17px;
    }

    .status {
      margin-top: 4px;
      font-size: 12px;
      color: var(--success);
    }

    .reset {
      border: 1px solid var(--line);
      background: #ffffff;
      color: var(--muted);
      padding: 9px 12px;
      border-radius: 10px;
      cursor: pointer;
    }

    .messages {
      padding: 24px;
      overflow-y: auto;
      max-height: 650px;
      scroll-behavior: smooth;
    }

    .message {
      display: flex;
      margin-bottom: 18px;
    }

    .message.user {
      justify-content: flex-end;
    }

    .bubble {
      max-width: 84%;
      padding: 14px 16px;
      border-radius: 18px;
      font-size: 14px;
      line-height: 1.65;
    }

    .bot .bubble {
      background: #f4f6fb;
      border: 1px solid #edf0f6;
      border-top-left-radius: 6px;
    }

    .user .bubble {
      background: var(--primary);
      color: #ffffff;
      border-top-right-radius: 6px;
    }

    .welcome {
      background: linear-gradient(135deg, #f8faff, #eef2ff);
      border: 1px solid #dfe5ff;
      border-radius: 18px;
      padding: 18px;
    }

    .welcome h3 {
      margin: 0 0 8px;
      font-size: 16px;
    }

    .welcome p {
      margin: 0;
      color: #526078;
      font-size: 13px;
      line-height: 1.6;
    }

    .manual {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      margin-top: 10px;
    }

    .manual-head {
      padding: 16px 17px;
      background: #f8faff;
      border-bottom: 1px solid var(--line);
    }

    .eyebrow {
      font-size: 11px;
      color: var(--primary);
      font-weight: 800;
      letter-spacing: 0.08em;
    }

    .manual-head h3 {
      font-size: 16px;
      margin: 5px 0 0;
    }

    .manual-body {
      padding: 16px 17px;
    }

    .step {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 10px;
      margin-bottom: 13px;
    }

    .num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--soft);
      color: var(--primary);
      font-size: 13px;
      font-weight: 800;
    }

    .step b {
      font-size: 14px;
    }

    .step p {
      margin: 3px 0 0;
      font-size: 13px;
      color: #596273;
      line-height: 1.55;
    }

    .example-toggle {
      width: 100%;
      margin-top: 14px;
      border: 1px solid #b9d8ca;
      background: #f4fbf7;
      color: var(--success);
      border-radius: 12px;
      padding: 11px 13px;
      font-weight: 800;
      cursor: pointer;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .example-toggle:hover {
      background: #eaf7f0;
    }

    .example-toggle .arrow {
      transition: transform 0.2s;
    }

    .example-toggle.open .arrow {
      transform: rotate(180deg);
    }

    .script {
      display: none;
      margin-top: 9px;
      padding: 14px;
      border-radius: 14px;
      background: #f0f7f4;
      border-left: 4px solid var(--success);
      font-size: 13px;
      line-height: 1.7;
    }

    .script.show {
      display: block;
      animation: fade 0.2s ease;
    }

    .script strong {
      display: block;
      color: var(--success);
      margin-bottom: 5px;
    }

    @keyframes fade {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .alert {
      margin-top: 12px;
      padding: 12px 14px;
      border-radius: 12px;
      background: #fff2f1;
      color: #842b25;
      border: 1px solid #ffd7d3;
      font-size: 12px;
      line-height: 1.55;
    }

    .quick {
      padding: 0 24px 12px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .quick button {
      border: 1px solid #cdd5f8;
      background: #ffffff;
      color: #3347a9;
      border-radius: 999px;
      padding: 9px 12px;
      font-size: 12px;
      cursor: pointer;
    }

    .composer {
      border-top: 1px solid var(--line);
      padding: 16px 18px 18px;
    }

    .inputbox {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: end;
      border: 1px solid #d9deea;
      border-radius: 16px;
      padding: 8px 8px 8px 14px;
    }

    .inputbox:focus-within {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(53, 89, 224, 0.08);
    }

    textarea {
      border: 0;
      outline: 0;
      resize: none;
      min-height: 42px;
      max-height: 110px;
      padding: 10px 0;
      background: transparent;
    }

    .send {
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 13px;
      background: var(--primary);
      color: #ffffff;
      cursor: pointer;
      font-size: 18px;
    }

    .helper {
      font-size: 11px;
      color: #949baa;
      margin: 8px 4px 0;
    }

    .typing {
      display: inline-flex;
      gap: 4px;
    }

    .typing i {
      width: 6px;
      height: 6px;
      background: #9aa2b2;
      border-radius: 50%;
      animation: bounce 1s infinite;
    }

    .typing i:nth-child(2) {
      animation-delay: 0.15s;
    }

    .typing i:nth-child(3) {
      animation-delay: 0.3s;
    }

    @keyframes bounce {
      0%,
      80%,
      100% {
        transform: translateY(0);
      }

      40% {
        transform: translateY(-5px);
      }
    }

    @media (max-width: 820px) {
      .app {
        grid-template-columns: 1fr;
        padding: 10px;
      }

      .sidebar {
        min-height: auto;
      }

      .side {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .label {
        grid-column: 1 / -1;
      }

      .scenario {
        margin: 0;
      }

      .note {
        display: none;
      }

      .chat {
        min-height: 680px;
      }
    }

    @media (max-width: 520px) {
      .side {
        grid-template-columns: 1fr;
      }

      .messages {
        padding: 16px 14px;
      }

      .quick {
        padding-left: 14px;
        padding-right: 14px;
      }

      .bubble {
        max-width: 94%;
      }
    }
  </style>
</head>

<body>
  <main class="app">
    <aside class="panel sidebar">
      <div class="brand">
        <div class="brand-row">
          <div class="logo">W</div>

          <div>
            <h1>워크가이드</h1>
            <p>직업훈련 대응 챗봇</p>
          </div>
        </div>
      </div>

      <div class="side">
        <div class="label">상황별 빠른 연습</div>

        <button class="scenario" data-key="order">
          <span class="emoji">🥤</span>
          <span>
            <b>음료 제조 실수</b>
            <small>잘못 만든 음료를 발견했어요.</small>
          </span>
        </button>

        <button class="scenario" data-key="delay">
          <span class="emoji">⏱️</span>
          <span>
            <b>서비스 지연·고객 화남</b>
            <small>고객이 큰 목소리로 항의해요.</small>
          </span>
        </button>

        <button class="scenario" data-key="harassment">
          <span class="emoji">🛡️</span>
          <span>
            <b>직장 내 성희롱</b>
            <small>불쾌한 말이나 행동을 겪었어요.</small>
          </span>
        </button>

        <button class="scenario" data-key="smalltalk">
          <span class="emoji">💬</span>
          <span>
            <b>동료와 스몰토크</b>
            <small>무슨 말을 해야 할지 모르겠어요.</small>
          </span>
        </button>
      </div>

      <div class="note">
        직업훈련용 연습 목업입니다. 긴급하거나 위험한 상황에서는
        현장 책임자, 보호자 또는 관련 전문기관에 즉시 도움을 요청하세요.
      </div>
    </aside>

    <section class="panel chat">
      <header class="header">
        <div class="assistant">
          <div class="avatar">🤖</div>

          <div>
            <h2>대응 도우미</h2>
            <div class="status">● 훈련 모드</div>
          </div>
        </div>

        <button class="reset" id="reset">처음부터</button>
      </header>

      <div class="messages" id="messages">
        <div class="message bot">
          <div class="bubble">
            <div class="welcome">
              <h3>어떤 상황이 발생했나요?</h3>

              <p>
                왼쪽에서 상황을 선택하거나 아래 입력창에 문제를 자유롭게
                입력하세요. 상황에 맞는 행동 순서와 실제로 말할 수 있는
                스크립트를 안내합니다.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="quick">
          <button data-text="카페에서 음료를 잘못 만들었어요">
            음료를 잘못 만들었어요
          </button>

          <button data-text="손님이 오래 기다렸다며 화를 내요">
            손님이 화를 내요
          </button>

          <button data-text="직장 동료가 불쾌한 성적 농담을 했어요">
            성적 농담을 들었어요
          </button>

          <button data-text="동료와 무슨 대화를 해야 할지 모르겠어요">
            스몰토크가 어려워요
          </button>
        </div>

        <div class="composer">
          <div class="inputbox">
            <textarea
              id="input"
              placeholder="예: 고객이 주문이 늦다며 화를 내고 있어요"
            ></textarea>

            <button class="send" id="send" aria-label="보내기">➤</button>
          </div>

          <div class="helper">
            Enter로 전송 · Shift+Enter로 줄바꿈
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const manuals = {
      order: {
        title: "음료 제조 실수 대응",

        steps: [
          [
            "실수를 즉시 확인하기",
            "주문서와 제조한 음료를 비교하고 무엇이 잘못되었는지 확인합니다."
          ],
          [
            "고객에게 먼저 사과하기",
            "변명보다 짧고 분명한 사과를 먼저 전달합니다."
          ],
          [
            "재제조와 예상 시간 안내",
            "새 음료를 바로 만들고 얼마나 걸리는지 구체적으로 말합니다."
          ],
          [
            "관리자 또는 동료에게 공유",
            "혼자 해결하기 어렵거나 반복된 실수라면 즉시 도움을 요청합니다."
          ]
        ],

        script:
          "“죄송합니다. 제가 주문 내용을 잘못 확인했습니다. 바로 새로 만들어 드리겠습니다. 약 3분 정도 걸릴 예정입니다.”"
      },

      delay: {
        title: "서비스 지연·화난 고객 대응",

        steps: [
          [
            "고객의 말을 끊지 않고 듣기",
            "고객이 불편했던 점을 먼저 말할 수 있도록 차분히 듣습니다."
          ],
          [
            "감정을 인정하고 사과하기",
            "고객이 오래 기다린 사실과 불편함을 인정합니다."
          ],
          [
            "현재 상황과 해결 방법 안내",
            "주문 상태, 예상 대기 시간, 가능한 대안을 짧게 설명합니다."
          ],
          [
            "위험 신호가 있으면 관리자 호출",
            "욕설, 위협, 폭력 가능성이 있으면 혼자 대응하지 않습니다."
          ]
        ],

        script:
          "“많이 기다리게 해 드려 죄송합니다. 현재 주문을 우선 확인하고 있습니다. 약 5분 안에 준비해 드리겠습니다. 더 빠른 대안이 가능한지도 확인하겠습니다.”"
      },

      harassment: {
        title: "직장 내 성희롱 대응",

        steps: [
          [
            "안전한 장소로 이동하기",
            "불편하거나 위협을 느끼면 상대와 거리를 두고 혼자 있지 않습니다."
          ],
          [
            "명확하게 중단 요청하기",
            "가능한 경우 불쾌하다는 점과 행동을 멈춰 달라는 뜻을 분명히 말합니다."
          ],
          [
            "기록 남기기",
            "날짜, 장소, 말이나 행동, 목격자 등을 가능한 한 구체적으로 기록합니다."
          ],
          [
            "책임자·상담창구에 알리기",
            "관리자, 인사 담당자, 고충처리 담당자 등 공식 도움을 요청합니다."
          ]
        ],

        script:
          "“그 말은 불편합니다. 그런 말이나 행동은 하지 말아 주세요. 이 상황은 담당자에게 알리겠습니다.”",

        alert:
          "즉각적인 위협이나 신체 접촉이 있는 경우에는 혼자 해결하려 하지 말고 즉시 안전한 장소로 이동해 주변 사람과 책임자에게 도움을 요청하세요."
      },

      smalltalk: {
        title: "동료와 스몰토크 시작하기",

        steps: [
          [
            "가벼운 공통 주제로 시작하기",
            "날씨, 업무 일정, 점심, 출퇴근처럼 부담이 적은 주제를 고릅니다."
          ],
          [
            "짧은 질문 하나 하기",
            "상대가 쉽게 답할 수 있는 열린 질문을 사용합니다."
          ],
          [
            "상대의 답에서 한 가지 이어가기",
            "상대가 말한 단어를 활용해 짧게 반응하거나 추가 질문을 합니다."
          ],
          [
            "대화를 자연스럽게 마무리하기",
            "업무로 돌아가야 할 때는 짧게 인사하며 끝냅니다."
          ]
        ],

        script:
          "“오늘 출근길은 괜찮으셨어요?” → “아, 지하철이 많이 붐볐군요. 저도 오늘 사람이 많더라고요.” → “이따 업무 잘 부탁드립니다!”"
      },

      default: {
        title: "문제상황 기본 대응",

        steps: [
          [
            "상황을 잠시 멈추고 확인하기",
            "무슨 일이 있었는지, 누구에게 어떤 불편이나 위험이 있는지 확인합니다."
          ],
          [
            "안전과 긴급성 판단하기",
            "다치거나 위협받는 사람이 있다면 업무보다 안전 확보가 우선입니다."
          ],
          [
            "짧고 공손하게 말하기",
            "사과, 상황 설명, 다음 행동을 한 문장씩 전달합니다."
          ],
          [
            "혼자 해결이 어렵다면 도움 요청하기",
            "관리자나 담당자에게 사실 중심으로 상황을 공유합니다."
          ]
        ],

        script:
          "“현재 상황을 확인했습니다. 불편을 드려 죄송합니다. 제가 먼저 가능한 조치를 하고, 필요한 경우 담당자에게 바로 도움을 요청하겠습니다.”"
      }
    };

    const messages = document.getElementById("messages");
    const input = document.getElementById("input");

    function classify(text) {
      const value = text.toLowerCase();

      if (/음료|주문.*잘못|잘못.*만들|제조.*실수/.test(value)) {
        return "order";
      }

      if (/늦|지연|기다|화.*내|항의|고객.*화|손님.*화/.test(value)) {
        return "delay";
      }

      if (/성희롱|성적|불쾌.*말|신체.*접촉|농담/.test(value)) {
        return "harassment";
      }

      if (/스몰토크|대화.*어려|무슨 말|동료.*대화|어색/.test(value)) {
        return "smalltalk";
      }

      return "default";
    }

    function addUser(text) {
      messages.insertAdjacentHTML(
        "beforeend",
        `
          <div class="message user">
            <div class="bubble">${escapeHtml(text)}</div>
          </div>
        `
      );
    }

    function addTyping() {
      const element = document.createElement("div");

      element.className = "message bot";
      element.id = "typing";

      element.innerHTML = `
        <div class="bubble">
          <span class="typing">
            <i></i>
            <i></i>
            <i></i>
          </span>
        </div>
      `;

      messages.appendChild(element);
      scrollBottom();
    }

    function renderManual(key) {
      const manual = manuals[key];

      const steps = manual.steps
        .map(
          (step, index) => `
            <div class="step">
              <div class="num">${index + 1}</div>

              <div>
                <b>${step[0]}</b>
                <p>${step[1]}</p>
              </div>
            </div>
          `
        )
        .join("");

      const alert = manual.alert
        ? `<div class="alert">${manual.alert}</div>`
        : "";

      return `
        <div class="manual">
          <div class="manual-head">
            <div class="eyebrow">RULE-BASED GUIDE</div>
            <h3>${manual.title}</h3>
          </div>

          <div class="manual-body">
            ${steps}

            <button
              class="example-toggle"
              type="button"
              onclick="toggleExample(this)"
            >
              <span class="toggle-label">💬 답변 예시 보기</span>
              <span class="arrow">⌄</span>
            </button>

            <div class="script">
              <strong>이렇게 말해 보세요</strong>
              ${manual.script}
            </div>

            ${alert}
          </div>
        </div>
      `;
    }

    function addBot(key) {
      const typing = document.getElementById("typing");

      if (typing && typing.parentNode) {
        typing.parentNode.removeChild(typing);
      }

      messages.insertAdjacentHTML(
        "beforeend",
        `
          <div class="message bot">
            <div class="bubble">
              이 상황에서는 아래 순서대로 대응해 보세요.
              ${renderManual(key)}
            </div>
          </div>
        `
      );

      scrollBottom();
    }

    function submit(text) {
      const source =
        typeof text === "string"
          ? text
          : input.value;

      const value = source.trim();

      if (!value) {
        return;
      }

      addUser(value);

      input.value = "";

      addTyping();

      const key = classify(value);

      document
        .querySelectorAll(".scenario")
        .forEach((button) => {
          button.classList.toggle(
            "active",
            button.dataset.key === key
          );
        });

      window.setTimeout(() => {
        addBot(key);
      }, 500);
    }

    function scrollBottom() {
      messages.scrollTop = messages.scrollHeight;
    }

    function escapeHtml(text) {
      return text.replace(
        /[&<>"']/g,
        (character) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#039;"
          })[character]
      );
    }

    function toggleExample(button) {
      const example = button.nextElementSibling;

      if (!example) {
        return;
      }

      const isOpen = example.classList.contains("show");
      const label = button.querySelector(".toggle-label");

      if (isOpen) {
        example.classList.remove("show");
        button.classList.remove("open");

        if (label) {
          label.textContent = "💬 답변 예시 보기";
        }
      } else {
        example.classList.add("show");
        button.classList.add("open");

        if (label) {
          label.textContent = "💬 답변 예시 접기";
        }

        window.setTimeout(scrollBottom, 50);
      }
    }

    document.getElementById("send").onclick = () => {
      submit();
    };

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        submit();
      }
    });

    document
      .querySelectorAll(".scenario")
      .forEach((button) => {
        button.onclick = () => {
          const scenarioTexts = {
            order: "카페에서 음료를 잘못 만들었어요",
            delay: "서비스가 지연되어 고객이 화를 내고 있어요",
            harassment:
              "직장 내에서 불쾌한 성적 말이나 행동을 겪었어요",
            smalltalk:
              "동료와 스몰토크를 어떻게 시작해야 할지 모르겠어요"
          };

          submit(scenarioTexts[button.dataset.key]);
        };
      });

    document
      .querySelectorAll(".quick button")
      .forEach((button) => {
        button.onclick = () => {
          submit(button.dataset.text);
        };
      });

    document.getElementById("reset").onclick = () => {
      messages.innerHTML = `
        <div class="message bot">
          <div class="bubble">
            <div class="welcome">
              <h3>어떤 상황이 발생했나요?</h3>

              <p>
                왼쪽에서 상황을 선택하거나 아래 입력창에 문제를 자유롭게
                입력하세요. 상황에 맞는 행동 순서와 실제로 말할 수 있는
                스크립트를 안내합니다.
              </p>
            </div>
          </div>
        </div>
      `;

      document
        .querySelectorAll(".scenario")
        .forEach((button) => {
          button.classList.remove("active");
        });

      input.focus();
    };
  </script>
</body>
</html>